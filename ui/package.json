    "@halo-dev/ui-shared": "^2.26.0",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.19.0",
    "emoji-regex": "^10.6.0",
    "is-emoji-supported": "^0.0.5",
    "vue": "^3.5.40",
    "vue-router": "~5.1.0"
  },
  "devDependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@halo-dev/ui-plugin-bundler-kit": "^2.26.0",
    "@iconify-json/streamline-color": "^1.2.2",
    "@tiptap/core": "3.29.0",
    "@tiptap/extension-collaboration": "3.29.0",
    "@tsconfig/node24": "^24.0.4",
