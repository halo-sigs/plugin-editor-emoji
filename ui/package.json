{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-s generate-emoji-data && run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "run-s generate-emoji-data && vite build --watch --env-mode=development",
    "generate-emoji-data": "node scripts/generate-emoji-data.mjs",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s \"lint:*\"",
    "format": "prettier --write --experimental-cli src/ scripts/",
    "test:unit": "vitest --passWithNoTests",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@halo-dev/api-client": "^2.26.0",
